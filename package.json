{
  "name": "history-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run nations:check && vue-tsc -b && vite build",
    "build:wasm": "node scripts/build-lanczos-wasm.mjs",
    "map:data": "node scripts/vendor-map-data.mjs",
    "map:rivers": "node scripts/vendor-rivers.mjs",
    "nations:build": "tsx scripts/clip-nations.mjs --report",
    "nations:check": "tsx scripts/clip-nations.mjs --check",
    "map:world": "tsx scripts/render-drawn-world.mjs",
    "map:measure": "tsx scripts/measure-drawn.mjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "globe.gl": "^2.46.1",
    "pinia": "^4.0.2",
    "three": "^0.185.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@cublya/world-atlas": "^3.0.0-beta.2",
    "@napi-rs/canvas": "^1.0.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "polygon-clipping": "^0.15.7",
    "sane-topojson": "^4.0.0",
    "tsx": "^4.23.9",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.0",
    "world-atlas": "^2.0.2"
  }
